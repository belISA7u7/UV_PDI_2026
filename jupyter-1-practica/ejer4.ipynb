   ],
   "source": [
    "\n",
    "\n",
    "cadena = input(\"Ingrese una palabra o frase: \")\n",
    "\n",
    "cadena = cadena.lower()\n",
    "cadena = cadena.replace(\" \", \"\")\n",
    "\n",
    "\n",
    "invertida = \"\"\n",
    "i = len(cadena) - 1\n",
    "\n",
    "while i >= 0:\n",
    "    invertida += cadena[i]\n",
    "    i -= 1\n",
    "\n",
    "if cadena == invertida:\n",
    "    print(\"Es palíndromo\")\n",
    "else:\n",
    "    print(\"No es palíndromo\")\n"
   ]
  }
 ],
