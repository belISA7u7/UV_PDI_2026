   ],
   "source": [
    "\n",
    "\n",
    "numero = int(input(\"Ingrese un número entero: \"))\n",
    "\n",
    "if numero < 0:\n",
    "    print(\"No existe factorial de números negativos\")\n",
    "else:\n",
    "    factorial = 1\n",
    "    for i in range(1, numero + 1):\n",
    "        factorial *= i\n",
    "    print(f\"El factorial de {numero} es {factorial}\")\n"
   ]
  }
